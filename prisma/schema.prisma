generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// --- Content models (unchanged) ---
model News {
  id           Int          @id @default(autoincrement())
  title        String       @db.VarChar(200)
  slug         String       @unique @db.VarChar(255)
  excerpt      String       @db.Text
  content      String       @db.LongText
  image        String?      @db.VarChar(500)
  date         DateTime     @db.Date
  category     NewsCategory @default(Berita)
  status       Status       @default(draft)
  author       String       @db.VarChar(100)
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  published_at DateTime?    @db.Timestamp(6)
}

enum NewsCategory {
  Berita
  Pengumuman
  Artikel
  Press_Release
}

model Event {
  id                 Int          @id @default(autoincrement())
  title              String       @db.VarChar(200)
  slug               String       @unique @db.VarChar(255)
  excerpt            String       @db.Text
  content            String       @db.LongText
  image              String?      @db.VarChar(500)
  date               DateTime     @db.Date
  time               String       @db.VarChar(50)
  location           String       @db.VarChar(200)
  category           EventCategory @default(Event)
  status             EventStatus   @default(Upcoming)
  organizer          String       @db.VarChar(100)
  registrationEnabled Boolean     @default(false)
  registrationLink   String?      @db.VarChar(500)
  published_at       DateTime?    @db.Timestamp(6)
  publishStatus      Status       @default(draft) @map("publish_status")
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")
}

enum EventCategory {
  Event
  Seminar
  Workshop
  Konferensi
  Pelatihan
}
enum EventStatus {
  Upcoming
  Ongoing
  Completed
  Cancelled
}

model Book {
  id           BigInt    @id @default(autoincrement())
  kode_buku    String?   @db.VarChar(50)
  title        String    @db.VarChar(255)
  isbn         String?   @db.VarChar(50)
  penerbit     String?   @db.VarChar(255)
  penulis      String?   @db.Text
  editor       String?   @db.VarChar(255)
  ukuran       String?   @db.VarChar(50)
  halaman      Int?
  image        String?   @db.VarChar(500)
  kategori     String?   @db.VarChar(100)
  sinopsis     String?   @db.Text
  status       Status    @default(draft)
  published_at DateTime? @db.Timestamp(6)
  created_at   DateTime  @default(now()) @db.Timestamp(6)
  updated_at   DateTime  @updatedAt
}

enum Status {
  draft
  published
}

// --- NextAuth models, User Management, and Site Settings ---
enum UserStatus {
  INVITED
  ACTIVE
}
enum Role {
  ADMIN
  EDITOR
  VIEWER
}

model User {
  id              String       @id @default(cuid())
  name            String?
  email           String       @unique
  emailVerified   DateTime?
  hashedPassword  String?
  image           String?
  role            Role         @default(VIEWER)
  status          UserStatus   @default(INVITED)
  twoFactorSecret String?
  accounts        Account[]
  sessions        Session[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
}

model Invitation {
  id        String   @id @default(cuid())
  email     String   @unique
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())
}

model SiteSetting {

  id                 Int      @id @default(1)
  siteName           String?
  facebook           String?
  instagram          String?
  twitter            String?
  defaultTitle       String?
  defaultDescription String?
  ogImageUrl         String?
  smtpHost           String?
  smtpPort           Int?
  smtpUser           String?
  smtpPass           String?
  require2FA         Boolean  @default(false)
  passwordMinLength  Int      @default(8)
  sessionMaxAgeHours Int      @default(24)
  revalidateSeconds  Int      @default(60)
  ga4MeasurementId   String?
  metaPixelId        String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}


